# Server Configuration
PORT=4000
NODE_ENV=development

# Client / CORS Configuration
CLIENT_ORIGIN=http://localhost:8080

# Security & Authentication
JWT_SECRET=super_secret_jwt_key_change_in_production_min_32_chars
JWT_EXPIRES_IN=7d
COOKIE_SECRET=super_secret_cookie_signing_key_min_32_chars

# Database Configuration (SQLite default, ready for PostgreSQL)
DATABASE_FILE=data/proteintrack.db

# Optional PostgreSQL configuration when swapping from SQLite:
# DATABASE_URL=postgres://user:password@localhost:5432/proteintrack
