{
  "name": "proteintrack-backend",
  "version": "1.0.0",
  "description": "High-Performance Bio-Nutritional Backend for ProteinTrack",
  "main": "src/server.js",
  "type": "commonjs",
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node src/db/migrate.js",
    "seed": "node src/db/seed.js",
    "setup": "node src/db/migrate.js && node src/db/seed.js"
  },
  "keywords": [
    "proteintrack",
    "nutrition",
    "macros",
